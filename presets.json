    "node_count": 12,
    "custom_nodes": 0,
    "clip_loader_type": "stable_diffusion",
    "loras": [
      { "chain": 1, "name": "anima-highres-aesthetic-boost.safetensors", "strength": 0.7, "role": "高分辨率 / 审美增强" },
      { "chain": 2, "name": "AnimaNEWNSS8.safetensors", "strength": 0.7, "role": "风格" },
