      "quality": {
        "label": "A. 使用作者推荐的模型链，效果较好，出图快。",
        "hint": "（以 RTX 4060 为例，8–20s 一张）"
      },
      "base": {
        "label": "B. 只安装基础模型，能满足基本生图需求，可拓展性强",
        "hint": "（以 RTX 4060 为例，30–60s 一张）"
      }
    },
    "entry": {
      "agent": {
        "label": "A. 全由 Agent 托管，只需与 Agent 对话即可生图",
        "hint": "（token 花费量略高，适合懒人）"
      },
      "console": {
        "label": "B. 由 Agent 生提示词，您使用可视化“简易操作台”生图",
        "hint": "（适合小白）"
      },
      "webui": {
        "label": "C. 由 Agent 生提示词，您使用 ComfyUI WebUI 生图",
        "hint": "（适合想入门 ComfyUI 的人，容易进阶）"
      }
    },
    "size_tiers": {
      "1536": [[960, 1536], [1536, 960], [1024, 1024], [768, 768]],
      "960": [[720, 960], [960, 720], [960, 960], [640, 640]],
      "768": [[576, 768], [768, 576], [768, 768], [512, 512]]
    },
    "tier_labels": ["竖图", "横图", "方图", "试稿"]
  },
  "internal": {
